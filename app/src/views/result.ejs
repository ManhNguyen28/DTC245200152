<%- include('partials/header') %>
<% const pct = attempt.total ? Math.round(attempt.score / attempt.total * 100) : 0; %>
<section class="card">
  <div class="result-hero">
    <div class="score-ring" data-p="<%= pct %>">
      <div class="inner"><div><div class="big"><%= score10(attempt.score, attempt.total) %></div><div class="muted small">/ 10 điểm</div></div></div>
    </div>
    <div>
      <div class="category">Kết quả bài làm</div>
      <h1><%= attempt.quiz_title %></h1>
      <p><%- icon('user') %> <strong><%= attempt.full_name %></strong><% if (attempt.student_code) { %> (<%= attempt.student_code %>)<% } %></p>
      <p>
        <span class="badge"><%- icon('check') %> Đúng <%= attempt.score %>/<%= attempt.total %> câu</span>
        <span class="badge"><%- icon('clock') %> <%= formatDuration(attempt.duration) %></span>
        <span class="badge"><%- icon('calendar') %> <%= formatDate(attempt.submitted_at) %></span>
      </p>
      <p>
        <% if (attempt.is_late) { %><span class="pill pill-bad">Nộp quá thời gian – không tính điểm</span>
        <% } else if (passed) { %><span class="pill pill-ok"><%- icon('award') %> ĐẠT (yêu cầu ≥ <%= Number(attempt.pass_score) %>)</span>
        <% } else { %><span class="pill pill-warn">Chưa đạt (yêu cầu ≥ <%= Number(attempt.pass_score) %>)</span><% } %>
      </p>
      <div class="actions">
        <% if (passed) { %><a class="btn" href="/certificate/<%= attempt.id %>"><%- icon('award') %> Nhận giấy chứng nhận</a><% } %>
        <a class="btn btn-ghost" href="/quiz/<%= attempt.quiz_id %>">Về trang đề thi</a>
        <a class="btn btn-ghost" href="/quiz/<%= attempt.quiz_id %>/leaderboard"><%- icon('chart') %> Bảng xếp hạng</a>
        <a class="btn btn-ghost" href="/me/review"><%- icon('refresh') %> Ôn câu sai</a>
      </div>
    </div>
  </div>
</section>

<h2>Đáp án chi tiết</h2>
<% details.forEach((d, i) => { %>
  <section class="card question <%= d.is_correct ? 'correct' : 'wrong' %>">
    <div class="q-head">
      <div class="q-title"><span class="q-num">Câu <%= i + 1 %>.</span> <%= d.content %></div>
      <span class="pill diff-<%= d.difficulty %>"><%= DIFFICULTY[d.difficulty] %></span>
    </div>
    <% ['A', 'B', 'C', 'D'].forEach((opt) => { %>
      <div class="answer <%= opt === d.correct_option ? 'is-correct' : '' %> <%= opt === d.selected_option ? 'is-selected' : '' %>">
        <span class="opt-key"><%= opt %></span> <%= d['option_' + opt.toLowerCase()] %>
        <% if (opt === d.correct_option) { %><span class="tag ok">Đáp án đúng</span><% } %>
        <% if (opt === d.selected_option && !d.is_correct) { %><span class="tag bad">Bạn chọn</span><% } %>
      </div>
    <% }) %>
    <% if (!d.selected_option) { %><p class="muted small">Không trả lời câu này.</p><% } %>
    <% if (d.explanation) { %><div class="explain"><strong>Giải thích:</strong> <%= d.explanation %></div><% } %>
  </section>
<% }) %>
<%- include('partials/footer') %>
