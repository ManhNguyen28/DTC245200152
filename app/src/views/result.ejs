<%- include('partials/header') %>
<section class="card center">
  <h1>Kết quả: <%= attempt.quiz_title %></h1>
  <p>Thí sinh: <strong><%= attempt.full_name %></strong>
    <% if (attempt.student_code) { %>(<%= attempt.student_code %>)<% } %></p>
  <p class="score"><%= attempt.score %> / <%= attempt.total %></p>
  <p>Điểm hệ 10: <strong><%= score10(attempt.score, attempt.total) %></strong></p>
  <% if (attempt.is_late) { %><p class="pill pill-bad">Nộp quá thời gian – bài làm không được tính điểm</p><% } %>
  <p class="muted">Thời gian làm: <%= formatDuration(attempt.duration) %> · Nộp lúc <%= formatDate(attempt.submitted_at) %></p>
  <p>
    <a class="btn" href="/quiz/<%= attempt.quiz_id %>">Về trang đề thi</a>
    <a class="btn btn-ghost" href="/quiz/<%= attempt.quiz_id %>/leaderboard">Bảng xếp hạng</a>
  </p>
</section>

<% details.forEach((d, i) => { %>
  <section class="card question <%= d.is_correct ? 'correct' : 'wrong' %>">
    <h3>Câu <%= i + 1 %>. <%= d.content %></h3>
    <% ['A', 'B', 'C', 'D'].forEach((opt) => { %>
      <p class="answer <%= opt === d.correct_option ? 'is-correct' : '' %> <%= opt === d.selected_option ? 'is-selected' : '' %>">
        <strong><%= opt %>.</strong> <%= d['option_' + opt.toLowerCase()] %>
        <% if (opt === d.correct_option) { %><span class="tag ok">Đáp án đúng</span><% } %>
        <% if (opt === d.selected_option && !d.is_correct) { %><span class="tag bad">Bạn chọn</span><% } %>
      </p>
    <% }) %>
    <% if (!d.selected_option) { %><p class="muted">Không trả lời câu này.</p><% } %>
  </section>
<% }) %>
<%- include('partials/footer') %>
