<%- include('partials/header') %>
<form method="post" action="/attempt/<%= attempt.id %>/submit" id="quiz-form" data-remaining="<%= remaining %>">
  <%- include('partials/csrf') %>
  <section class="card sticky-head">
    <div class="page-head">
      <div>
        <h1><%= attempt.quiz_title %></h1>
        <p class="muted">Thí sinh: <strong><%= attempt.full_name %></strong>
          <% if (attempt.student_code) { %>(<%= attempt.student_code %>)<% } %></p>
      </div>
      <div class="timer">Còn lại <strong id="timer"></strong></div>
    </div>
    <p class="muted small">Đã trả lời <strong id="answered">0</strong>/<%= questions.length %> câu</p>
  </section>

  <% questions.forEach((q, i) => { %>
    <fieldset class="card question">
      <legend>Câu <%= i + 1 %>. <%= q.content %></legend>
      <% ['A', 'B', 'C', 'D'].forEach((opt) => { %>
        <label class="option">
          <input type="radio" name="q_<%= q.id %>" value="<%= opt %>">
          <strong><%= opt %>.</strong> <%= q['option_' + opt.toLowerCase()] %>
        </label>
      <% }) %>
    </fieldset>
  <% }) %>

  <button class="btn" type="submit" data-confirm-unanswered="1">Nộp bài</button>
</form>
<%- include('partials/footer') %>
