<%- include('partials/header') %>
<form class="card form narrow" method="post" action="/register">
  <h1>Đăng ký tài khoản</h1>
  <% if (errors.length) { %>
    <div class="flash flash-error"><ul><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul></div>
  <% } %>
  <%- include('partials/csrf') %>
  <label>Tên đăng nhập *
    <input name="username" value="<%= values.username || '' %>" required maxlength="30" pattern="[a-zA-Z0-9_.]{3,30}" autocomplete="username">
    <small class="muted">3–30 ký tự: chữ không dấu, số, dấu chấm, gạch dưới.</small>
  </label>
  <label>Họ và tên *
    <input name="full_name" value="<%= values.full_name || '' %>" required maxlength="100" autocomplete="name">
  </label>
  <label>Mã sinh viên
    <input name="student_code" value="<%= values.student_code || '' %>" maxlength="20">
  </label>
  <label>Mật khẩu *
    <input name="password" type="password" required minlength="8" maxlength="72" autocomplete="new-password">
    <small class="muted">Ít nhất 8 ký tự, gồm cả chữ và số.</small>
  </label>
  <label>Nhập lại mật khẩu *
    <input name="password_confirm" type="password" required minlength="8" maxlength="72" autocomplete="new-password">
  </label>
  <button class="btn block" type="submit">Tạo tài khoản</button>
  <p class="muted center">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
</form>
<%- include('partials/footer') %>
