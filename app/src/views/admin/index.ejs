<%- include('../partials/header') %>
<div class="page-head">
  <h1>Quản trị đề thi</h1>
  <a class="btn" href="/admin/quizzes/new">+ Tạo đề mới</a>
</div>

<section class="card">
  <table>
    <thead>
      <tr><th>Đề thi</th><th>Thời gian</th><th>Số câu</th><th>Lượt làm</th><th>Thao tác</th></tr>
    </thead>
    <tbody>
      <% quizzes.forEach((q) => { %>
        <tr>
          <td><%= q.title %></td>
          <td><%= q.time_limit %> phút</td>
          <td><%= q.question_count %></td>
          <td><%= q.attempt_count %></td>
          <td class="actions">
            <a href="/admin/quizzes/<%= q.id %>">Câu hỏi</a>
            <a href="/admin/quizzes/<%= q.id %>/results">Kết quả</a>
            <form method="post" action="/admin/quizzes/<%= q.id %>/delete" data-confirm="Xóa đề thi này cùng toàn bộ câu hỏi và kết quả?">
              <button class="link danger" type="submit">Xóa</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (quizzes.length === 0) { %>
        <tr><td colspan="5" class="muted">Chưa có đề thi nào.</td></tr>
      <% } %>
    </tbody>
  </table>
</section>

<h2>Lượt làm bài gần đây</h2>
<section class="card">
  <table>
    <thead>
      <tr><th>Thí sinh</th><th>Mã SV</th><th>Đề thi</th><th>Điểm</th><th>Thời gian nộp</th></tr>
    </thead>
    <tbody>
      <% recent.forEach((a) => { %>
        <tr>
          <td><a href="/result/<%= a.id %>"><%= a.student_name %></a></td>
          <td><%= a.student_code || '—' %></td>
          <td><%= a.quiz_title %></td>
          <td><%= a.score %>/<%= a.total %></td>
          <td><%= formatDate(a.submitted_at) %></td>
        </tr>
      <% }) %>
      <% if (recent.length === 0) { %>
        <tr><td colspan="5" class="muted">Chưa có lượt làm bài nào.</td></tr>
      <% } %>
    </tbody>
  </table>
</section>
<%- include('../partials/footer') %>
