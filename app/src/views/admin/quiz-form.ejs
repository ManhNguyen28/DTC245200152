<%- include('../partials/header') %>
<h1>Tạo đề thi mới</h1>
<form class="card form" method="post" action="/admin/quizzes">
  <label>Tiêu đề *
    <input name="title" required maxlength="200">
  </label>
  <label>Mô tả
    <textarea name="description" rows="3" maxlength="1000"></textarea>
  </label>
  <label>Thời gian làm bài (phút)
    <input name="time_limit" type="number" min="1" max="180" value="15">
  </label>
  <div>
    <button class="btn" type="submit">Tạo đề</button>
    <a href="/admin">Hủy</a>
  </div>
</form>
<%- include('../partials/footer') %>
