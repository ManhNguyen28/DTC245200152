<%- include('../partials/header') %>
<%- include('../partials/admin-nav', { active: 'dashboard' }) %>
<h1>Tổng quan hệ thống</h1>

<div class="grid kpis">
  <div class="stat"><div class="stat-icon"><%- icon('users', 'lg') %></div><div><div class="stat-value"><%= totals.students %></div><div class="stat-label">Học viên</div></div></div>
  <div class="stat"><div class="stat-icon"><%- icon('layers', 'lg') %></div><div><div class="stat-value"><%= totals.quizzes %></div><div class="stat-label">Đề thi</div></div></div>
  <div class="stat"><div class="stat-icon"><%- icon('list', 'lg') %></div><div><div class="stat-value"><%= totals.questions %></div><div class="stat-label">Câu hỏi</div></div></div>
  <div class="stat"><div class="stat-icon"><%- icon('check', 'lg') %></div><div><div class="stat-value"><%= totals.attempts %></div><div class="stat-label">Lượt nộp bài</div></div></div>
  <div class="stat"><div class="stat-icon"><%- icon('target', 'lg') %></div><div><div class="stat-value"><%= totals.avg_score ?? '—' %></div><div class="stat-label">Điểm trung bình</div></div></div>
</div>

<div class="two-col">
  <section class="card">
    <h3><%- icon('chart') %> Lượt nộp bài 7 ngày gần nhất</h3>
    <% const maxDay = Math.max(1, ...days.map((d) => d.n)); %>
    <div class="vbars">
      <% days.forEach((d) => { %>
        <div class="vbar">
          <span class="vbar-value"><%= d.n %></span>
          <div class="vbar-fill" data-h="<%= Math.round(d.n / maxDay * 100) %>"></div>
          <span class="vbar-label"><%= d.label %></span>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="card">
    <h3><%- icon('shield') %> Hoạt động gần đây</h3>
    <% events.forEach((e) => { %>
      <div class="event">
        <div><strong><%= e.username || 'khách' %></strong> · <code><%= e.action %></code><br><span class="muted small"><%= e.detail %></span></div>
        <div class="when"><%= formatDate(e.created_at) %></div>
      </div>
    <% }) %>
    <% if (events.length === 0) { %><p class="muted">Chưa có hoạt động.</p><% } %>
    <p><a href="/admin/audit">Xem toàn bộ nhật ký →</a></p>
  </section>
</div>

<div class="two-col">
  <section class="card table-wrap">
    <h3><%- icon('check') %> Bài nộp gần đây</h3>
    <table>
      <thead><tr><th>Học viên</th><th>Đề thi</th><th>Điểm</th><th>Nộp lúc</th></tr></thead>
      <tbody>
        <% recent.forEach((a) => { %>
          <tr>
            <td><a href="/result/<%= a.id %>"><%= a.full_name %></a><br><span class="muted small"><%= a.student_code || '' %></span></td>
            <td><%= a.quiz_title %></td>
            <td><%= a.score %>/<%= a.total %> <% if (a.is_late) { %><span class="pill pill-bad">Quá giờ</span><% } %></td>
            <td class="small"><%= formatDate(a.submitted_at) %></td>
          </tr>
        <% }) %>
        <% if (recent.length === 0) { %><tr><td colspan="4" class="muted">Chưa có bài nộp nào.</td></tr><% } %>
      </tbody>
    </table>
  </section>
  <section class="card table-wrap">
    <h3><%- icon('award') %> Đề được làm nhiều nhất</h3>
    <table>
      <thead><tr><th>Đề thi</th><th>Lượt</th><th>Điểm TB</th></tr></thead>
      <tbody>
        <% topQuizzes.forEach((q) => { %>
          <tr><td><a href="/admin/quizzes/<%= q.id %>/stats"><%= q.title %></a></td><td><%= q.attempts %></td><td><%= q.avg_score %></td></tr>
        <% }) %>
        <% if (topQuizzes.length === 0) { %><tr><td colspan="3" class="muted">Chưa có dữ liệu.</td></tr><% } %>
      </tbody>
    </table>
  </section>
</div>
<%- include('../partials/footer') %>
