<%- include('partials/header') %>
<form method="post" action="/quiz/<%= quiz.id %>/submit" id="quiz-form" data-time-limit="<%= quiz.time_limit %>">
  <section class="card">
    <h1><%= quiz.title %></h1>
    <p class="muted"><%= quiz.description %></p>
    <p class="timer">Thời gian còn lại: <strong id="timer"></strong></p>
    <div class="row">
      <label>Họ và tên *
        <input name="student_name" required maxlength="100" autocomplete="name">
      </label>
      <label>Mã sinh viên
        <input name="student_code" maxlength="20">
      </label>
    </div>
  </section>

  <% questions.forEach((q, i) => { %>
    <fieldset class="card question">
      <legend>Câu <%= i + 1 %>. <%= q.content %></legend>
      <% ['A', 'B', 'C', 'D'].forEach((opt) => { %>
        <label class="option">
          <input type="radio" name="q_<%= q.id %>" value="<%= opt %>">
          <strong><%= opt %>.</strong> <%= q['option_' + opt.toLowerCase()] %>
        </label>
      <% }) %>
    </fieldset>
  <% }) %>

  <button class="btn" type="submit">Nộp bài</button>
</form>
<%- include('partials/footer') %>
