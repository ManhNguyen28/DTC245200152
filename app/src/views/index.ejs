<%- include('partials/header') %>
<div class="page-head">
  <h1>Danh sách đề thi</h1>
</div>

<form class="card filter" method="get" action="/">
  <input name="q" value="<%= q %>" placeholder="Tìm theo tên hoặc mô tả đề thi..." maxlength="100">
  <select name="category">
    <option value="">Tất cả danh mục</option>
    <% categories.forEach((c) => { %>
      <option value="<%= c.id %>" <%= c.id === categoryId ? 'selected' : '' %>><%= c.name %></option>
    <% }) %>
  </select>
  <button class="btn" type="submit">Tìm</button>
  <% if (q || categoryId) { %><a href="/">Xóa lọc</a><% } %>
</form>

<% if (quizzes.length === 0) { %>
  <p class="muted">Không tìm thấy đề thi nào.</p>
<% } %>
<div class="grid">
  <% quizzes.forEach((quiz) => { %>
    <article class="card quiz-card">
      <% if (quiz.category_name) { %><span class="category"><%= quiz.category_name %></span><% } %>
      <h2><%= quiz.title %></h2>
      <p class="muted"><%= quiz.description %></p>
      <p>
        <span class="badge"><%= quiz.question_count %> câu</span>
        <span class="badge"><%= quiz.time_limit %> phút</span>
        <span class="badge"><%= quiz.max_attempts > 0 ? `Tối đa ${quiz.max_attempts} lượt` : 'Không giới hạn lượt' %></span>
      </p>
      <p class="muted small"><%= quiz.attempt_count %> lượt đã làm</p>
      <a class="btn" href="/quiz/<%= quiz.id %>">Xem đề</a>
    </article>
  <% }) %>
</div>
<%- include('partials/footer') %>
