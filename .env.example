# Sao chép file này thành .env rồi thay bằng mật khẩu mạnh của bạn:
#   cp .env.example .env
# File .env KHÔNG được đưa lên GitHub (đã khai báo trong .gitignore).

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=quizdb
MYSQL_USER=quiz_app
MYSQL_PASSWORD=change_me_app_password

# --- Tài khoản quản trị trang /admin ---
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_admin_password
