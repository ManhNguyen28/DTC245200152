# Sao chép file này thành .env rồi thay bằng mật khẩu mạnh của bạn:
#   cp .env.example .env
# File .env KHÔNG được đưa lên GitHub (đã khai báo trong .gitignore).

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=quizdb
MYSQL_USER=quiz_app
MYSQL_PASSWORD=change_me_app_password

# --- Tài khoản quản trị (ứng dụng tự tạo ở lần khởi động đầu tiên) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_admin_password

# --- Khóa ký cookie phiên đăng nhập: chuỗi ngẫu nhiên dài, ví dụ tạo bằng: openssl rand -hex 32 ---
SESSION_SECRET=change_me_long_random_string

# --- Địa chỉ công khai của máy chủ (IP hoặc tên miền người dùng gõ trên trình duyệt) ---
PUBLIC_HOST=localhost

# --- Tài khoản giám sát: đăng nhập Grafana và Prometheus ---
MONITOR_USER=monitor
MONITOR_PASSWORD=change_me_monitor_password

# --- Mật khẩu user MySQL "exporter" (chỉ đọc số liệu thống kê) cho mysqld-exporter ---
MYSQL_EXPORTER_PASSWORD=change_me_exporter_password
